# Required for live model calls and the independent Grok audit harness.
OPENROUTER_API_KEY=

# Required only when business research is enabled and the user explicitly
# authorizes paid fallback after the local crawl tier cannot retrieve a URL.
FIRECRAWL_API_KEY=

# Legacy/non-interactive fallback only. Normal local development uses the
# refreshable browser OAuth session stored under ignored `.one-box/oauth/`.
REFERO_MCP_TOKEN=

# Optional test/portability override for the ignored Refero OAuth state file.
ONE_BOX_REFERO_OAUTH_STORE=

# Optional: server-only Places API (New) competitor verification.
GOOGLE_PLACES_API_KEY=

# Optional: Maps Embed API market-map display.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional bearer for trusted non-browser mutation clients. Browser mutations
# still use the same-origin policy documented in docs/security.
ONE_BOX_API_TOKEN=

# Page IR is selected only for newly created runs when explicitly enabled.
# The kill switch wins and selects template-v1 for new runs only. Neither value
# changes the immutable authority of an existing run.
ONE_BOX_PAGE_IR_ROLLOUT=0
ONE_BOX_PAGE_IR_KILL_SWITCH=0

# Optional portability overrides.
CRAWL4AI_SCRIPT_PATH=
MISHMASH_CATALOG_PATH=

# Optional browser-test server URL.
ONEBOX_BASE_URL=http://127.0.0.1:3000
