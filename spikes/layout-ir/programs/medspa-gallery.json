      "constraints": [
        {
          "type": "span",
          "slot": "heading",
          "from": 1,
          "to": 4
        },
        {
          "type": "span",
          "slot": "items",
          "from": 1,
          "to": 4
        },
        {
          "type": "measure",
          "slot": "heading",
          "value": "normal"
        }
      ]
    },
    {
