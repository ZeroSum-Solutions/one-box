        {
          "name": "items",
          "collectionRef": "why-us.point"
        }
      ],
      "constraints": [
        {
          "type": "span",
          "slot": "heading",
          "from": 1,
          "to": 3
        },
        {
          "type": "span",
          "slot": "items",
          "from": 1,
          "to": 3
        },
        {
          "type": "measure",
          "slot": "heading",
          "value": "normal"
        }
      ]
    },
