        "kind": "stack",
        "align": "start",
        "gap": 1
      },
      "surface": "page",
      "seam": "flush",
      "slots": [
        {
          "name": "heading",
          "copyRef": "service-area.intro"
        },
        {
          "name": "items",
          "collectionRef": "service-area.area"
        }
      ],
      "constraints": [
        {
          "type": "span",
          "slot": "heading",
          "from": 1,
          "to": 9
        },
        {
          "type": "span",
          "slot": "items",
          "from": 1,
          "to": 13
        }
      ]
    },
    {
      "id": "contact",
      "role": "contact",
      "kernel": {
        "kind": "split",
        "ratio": "5-7",
        "gap": 3
      },
      "surface": "accent",
      "seam": "band",
      "slots": [
        {
          "name": "heading",
          "copyRef": "contact.headline"
        },
        {
          "name": "lede",
          "copyRef": "contact.sub"
        },
        {
          "name": "actions",
          "copyRef": "contact.cta"
        }
      ],
      "constraints": [
        {
          "type": "span",
          "slot": "heading",
          "from": 1,
          "to": 2,
          "row": 1,
          "rowSpan": 2
        },
        {
          "type": "span",
          "slot": "lede",
          "from": 2,
          "to": 3,
          "row": 1
        },
        {
          "type": "span",
          "slot": "actions",
          "from": 2,
          "to": 3,
          "row": 2
