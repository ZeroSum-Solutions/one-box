          "copyRef": "footer.tagline"
        },
        {
          "name": "actions",
          "copyRef": "footer.phone"
        }
      ],
      "constraints": [
        {
          "type": "align",
          "slot": "actions",
          "axis": "inline",
          "value": "end"
        }
      ]
