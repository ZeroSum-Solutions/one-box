{
  "name": "one-box",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "eval:baseline:verify": "node scripts/eval/baseline-harness.mjs verify",
    "eval:baseline:prepare": "node scripts/eval/baseline-harness.mjs prepare",
    "eval:baseline:live": "node scripts/eval/baseline-live-runner.mjs",
    "eval:baseline:request-path-b": "node scripts/eval/baseline-live-runner.mjs request-path-b",
    "eval:model-benchmark": "node scripts/eval/model-benchmark.mjs",
    "test:eval": "node --test scripts/eval/*.node.mjs",
    "test:smoke": "node scripts/smoke/gates-smoke.mjs && node scripts/smoke/scan-filter-smoke.mjs",
    "test:e2e:intake": "node scripts/e2e/intake-upload.mjs",
    "test:e2e:preview": "node scripts/e2e/preview-workbench.mjs",
    "test:e2e:motion": "node scripts/e2e/motion-runtime.mjs",
    "test:e2e:token-motion": "node scripts/e2e/token-motion-workbench.mjs",
    "test:e2e:full-unit": "node --test scripts/e2e/full-run-state.node.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.64",
    "cheerio": "^1.2.0",
    "gsap": "3.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
