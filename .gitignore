# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated runs
/sites/

# local QA evidence — screenshots are re-capturable from the gate harnesses
/docs/screenshots/

# private local intake staging; uploads are claimed into ignored run data
/.one-box/

# local evaluation runs contain sealed blind mappings and coordinator-only state
/docs/eval/baseline/runs/
/docs/eval/model-routing/runs/
/docs/eval/page-ir-safe-pipeline/runs/
spikes/layout-ir/out/
spikes/layout-ir/shots/
spikes/layout-ir/verify-report.json
references/
spikes/wits-variants/*/site/img/
